### ==========================================
### 1. SHOP ENDPOINTS
### ==========================================

### 1a. Create First Shop (Fresh Mart)
POST http://localhost:8080/shops
Content-Type: application/json

{
  "name": "Fresh Mart",
  "address": "123 Main Street, Sector 5",
  "phone": "+919876543210"
}

### 1b. Create Second Shop (Local Mart) - For Isolation Testing
POST http://localhost:8080/shops
Content-Type: application/json

{
  "name": "Local Mart",
  "address": "456 Market Road, Sector 2",
  "phone": "+919876543211"
}

### 1c. Get All Shops
GET http://localhost:8080/shops


### ==========================================
### 2. CATEGORY ENDPOINTS (Day 6)
### ==========================================

### 2a. Create Category 1 (Dairy) for Shop 1
POST http://localhost:8080/shops/1/categories
Content-Type: application/json

{
  "name": "Dairy",
  "description": "Milk and dairy products"
}

### 2b. Create Category 2 (Bakery) for Shop 1
POST http://localhost:8080/shops/1/categories
Content-Type: application/json

{
  "name": "Bakery",
  "description": "Freshly baked bread and pastries"
}

### 2c. Create Category 3 (Snacks) for Shop 1
POST http://localhost:8080/shops/1/categories
Content-Type: application/json

{
  "name": "Snacks",
  "description": "Chips, cookies, and quick snacks"
}

### 2d. Create Category 4 (Beverages) for Shop 1
POST http://localhost:8080/shops/1/categories
Content-Type: application/json

{
  "name": "Beverages",
  "description": "Tea, coffee, juice, and waters"
}

### 2e. Get All Categories for Shop 1
GET http://localhost:8080/shops/1/categories

### 2f. Update Category 1 (Dairy -> Dairy & Frozen)
PUT http://localhost:8080/categories/1
Content-Type: application/json

{
  "name": "Dairy & Frozen",
  "description": "Milk, cheese, butter and frozen dairy items"
}


